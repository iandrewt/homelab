# Managed by Ansible (frr_bgp role).
{% set routed = frr_bgp_service_addresses + frr_bgp_anycast_addresses %}
network:
  version: 2
  ethernets:
{% if frr_bgp_service_addresses %}
    lo:
      match:
        name: lo
      addresses:
{% for address in frr_bgp_service_addresses %}
        - {{ address }}/{{ 128 if ':' in address else 32 }}
{% endfor %}
{% endif %}
    # Answered on-link, a reply leaves the router's firewall seeing half a flow.
    # netplan appends these to cloud-init's definition of the same interface.
    {{ frr_bgp_uplink }}:
      match:
        name: "{{ frr_bgp_uplink_match }}"
{% if frr_bgp_uplink_dhcp %}
      # As its seed or the image declared it, which this definition replaces
      dhcp4: true
      dhcp6: true
      emit-lldp: true
      link-local: [ipv6]
{% for overrides in ['dhcp4-overrides', 'dhcp6-overrides', 'ra-overrides'] %}
      {{ overrides }}:
        use-domains: true
{% if frr_bgp_uplink_nameservers %}
        use-dns: false
{% endif %}
{% endfor %}
{% if frr_bgp_uplink_nameservers %}
      nameservers:
        addresses: {{ frr_bgp_uplink_nameservers | to_json }}
{% endif %}
{% endif %}
      routes:
{% for gateway in frr_bgp_gateways %}
        - to: default
          via: {{ gateway }}
          table: {{ frr_bgp_reply_table }}
          on-link: true
{% endfor %}
      routing-policy:
{% for address in routed %}
        - from: {{ address }}/{{ 128 if ':' in address else 32 }}
          table: {{ frr_bgp_reply_table }}
{% endfor %}
{% if frr_bgp_anycast_addresses %}
  dummy-devices:
    anycast0:
      # Held down; anycast-check raises it only while the service it fronts answers
      activation-mode: manual
      addresses:
{% for address in frr_bgp_anycast_addresses %}
        - {{ address }}/{{ 128 if ':' in address else 32 }}
{% endfor %}
{% endif %}
