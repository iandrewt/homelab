! Managed by Ansible (frr_bgp role) - edit host_vars / this role, not this file.
{% set groups = {'SERVICE': frr_bgp_service_addresses, 'ANYCAST': frr_bgp_anycast_addresses} %}
{% set families = {'ipv4': {'keyword': 'ip', 'length': 32, 'v6': False},
                   'ipv6': {'keyword': 'ipv6', 'length': 128, 'v6': True}} %}
frr version 10.3
frr defaults datacenter
hostname {{ inventory_hostname }}
!
{% for afi, family in families.items() %}
{%   set seq = namespace(n=0) %}
{%   for group, addresses in groups.items() %}
{%     set mine = addresses | select('search', ':') | list if family.v6 else addresses | reject('search', ':') | list %}
{%     if mine %}
{%       for address in mine %}
{{ family.keyword }} prefix-list {{ group }}-{{ afi | upper }} seq {{ loop.index * 5 }} permit {{ address }}/{{ family.length }}
{%       endfor %}
!
{%       set seq.n = seq.n + 10 %}
route-map TO-UPSTREAM-{{ afi | upper }} permit {{ seq.n }}
 match {{ family.keyword }} address prefix-list {{ group }}-{{ afi | upper }}
exit
!
{%     endif %}
{%   endfor %}
{% endfor %}
route-map NOTHING deny 10
exit
!
router bgp {{ frr_bgp_local_asn }}
 bgp router-id {{ frr_bgp_router_id }}
 bgp ebgp-requires-policy
 bgp network import-check
 no bgp default ipv4-unicast
 neighbor {{ frr_bgp_peer_address }} remote-as {{ frr_bgp_peer_asn }}
{% if frr_bgp_password is not none %}
 neighbor {{ frr_bgp_peer_address }} password {{ frr_bgp_password }}
{% endif %}
{% if ':' in frr_bgp_peer_address %}
 neighbor {{ frr_bgp_peer_address }} capability extended-nexthop
{% endif %}
{% for afi, family in families.items() %}
{%   set advertised = (frr_bgp_service_addresses + frr_bgp_anycast_addresses) %}
{%   set advertised = advertised | select('search', ':') | list if family.v6 else advertised | reject('search', ':') | list %}
{%   if advertised %}
 !
 address-family {{ afi }} unicast
{%     for address in advertised %}
  network {{ address }}/{{ family.length }}
{%     endfor %}
  neighbor {{ frr_bgp_peer_address }} activate
  neighbor {{ frr_bgp_peer_address }} route-map NOTHING in
  neighbor {{ frr_bgp_peer_address }} route-map TO-UPSTREAM-{{ afi | upper }} out
 exit-address-family
{%   endif %}
{% endfor %}
!
line vty
!
