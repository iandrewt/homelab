# Managed by Ansible (frr_bgp role).
[Unit]
{% set units = [frr_bgp_anycast_service] + frr_bgp_anycast_needs %}
Description=anycast0 up while {{ units | join(' and ') }} run
BindsTo={{ units | join(' ') }} sys-subsystem-net-devices-anycast0.device
After={{ units | join(' ') }} sys-subsystem-net-devices-anycast0.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip link set anycast0 up
ExecStop=/usr/sbin/ip link set anycast0 down

[Install]
UpheldBy={{ frr_bgp_anycast_service }}
