#!/bin/sh
# Managed by Ansible (frr_bgp role). Holds anycast0 up while this host isn't drained, what it
# fronts runs, and the check passes.
while :; do
  if [ ! -e {{ frr_bgp_anycast_drain }} ] \
    && systemctl is-active --quiet {{ ([frr_bgp_anycast_service] + frr_bgp_anycast_needs) | join(' ') }} \
    && {{ frr_bgp_anycast_check }} >/dev/null 2>&1; then
    systemctl start anycast.service
  else
    systemctl stop anycast.service
  fi
  sleep {{ frr_bgp_anycast_interval }}
done
