# Managed by Ansible (frr_bgp role).
[Unit]
Description=Raise anycast0 while this host is healthy and not drained, and lower it otherwise

[Service]
Environment="ANYCAST_DRAIN={{ frr_bgp_anycast_drain }}"
Environment="ANYCAST_UNITS={{ ([frr_bgp_anycast_service] + frr_bgp_anycast_needs) | join(' ') }}"
Environment="ANYCAST_CHECK={{ frr_bgp_anycast_check }}"
Environment="ANYCAST_INTERVAL={{ frr_bgp_anycast_interval }}"
ExecStart=/usr/libexec/homelab/anycast-check
Restart=always
StateDirectory=anycast

[Install]
WantedBy=multi-user.target
