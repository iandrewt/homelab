# Managed by Ansible (proxmox_host role) - edit ipam.yaml / this role, not this file.
{% set bridge_uplink = 'bond0' if proxmox_host_use_bonding else proxmox_host_uplink_nics[0] %}

auto lo
iface lo inet loopback

{% for nic in proxmox_host_uplink_nics %}
iface {{ nic }} inet manual
{% endfor %}

{% if proxmox_host_use_bonding %}
auto bond0
iface bond0 inet manual
	bond-slaves {{ proxmox_host_uplink_nics | join(' ') }}
	bond-mode {{ proxmox_host_bond_mode }}
	bond-xmit-hash-policy {{ proxmox_host_bond_hash_policy }}
	bond-miimon 100

{% endif %}
auto vmbr0
iface vmbr0 inet manual
	bridge-ports {{ bridge_uplink }}
	bridge-stp off
	bridge-vlan-aware yes
	bridge-vids 2-4094

auto vmbr0.{{ vlan_id }}
{% if proxmox_host_mgmt_use_dhcp %}
iface vmbr0.{{ vlan_id }} inet dhcp
{% else %}
iface vmbr0.{{ vlan_id }} inet static
	address {{ static_ipv4 }}/24
	gateway {{ proxmox_host_mgmt_gateway_ipv4 }}
{% endif %}
iface vmbr0.{{ vlan_id }} inet6 static
	address {{ static_ipv6 }}/64
	accept_ra 1

source /etc/network/interfaces.d/*
