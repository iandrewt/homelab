# Managed by Ansible (powerdns_resolver role) - edit host_vars / this role, not this file.
{% if powerdns_resolver_role == 'primary' %}
primary=yes
{% else %}
secondary=yes
{% endif %}

launch=lmdb
lmdb-filename=/var/lib/powerdns/pdns.lmdb
lmdb-shards={{ powerdns_resolver_lmdb_shards }}
local-address={{ static_ipv4 }}
local-port=53

{% if powerdns_resolver_role == 'primary' %}
webserver=yes
webserver-address={{ static_ipv4 }}
webserver-port=8081
webserver-allow-from=0.0.0.0/0
api=yes
api-key={{ powerdns_resolver_api_key }}

also-notify={{ powerdns_resolver_peer_address }}:53
allow-axfr-ips={{ powerdns_resolver_peer_address }}
{% else %}
webserver=no
api=no
allow-notify-from={{ powerdns_resolver_peer_address }}
{% endif %}
