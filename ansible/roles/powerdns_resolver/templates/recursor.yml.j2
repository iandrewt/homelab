# Managed by Ansible (powerdns_resolver role) - edit host_vars / this role, not this
dnssec:
  validation: "{{ powerdns_resolver_dnssec_validation }}"
incoming:
  listen:
    - 127.0.0.1
    - ::1
{% if powerdns_resolver_allow_from %}
  allow_from:
{% for subnet in powerdns_resolver_allow_from %}
    - {{ subnet }}
{% endfor %}
{% endif %}
outgoing:
  source_address:
    - 0.0.0.0
    - "::"
recursor:
  forward_zones:
{% for zone in [powerdns_resolver_zone] + powerdns_resolver_reverse_zones %}
    - zone: {{ zone }}
      forwarders:
        - {{ static_ipv4 }}:53
      recurse: false
{% endfor %}
