-- Managed by Ansible (powerdns_resolver role) - edit host_vars / this role, not this file.
{% set anycast_addrs = [] %}
{% if powerdns_resolver_anycast_v4 is defined %}
{% set _ = anycast_addrs.append(powerdns_resolver_anycast_v4 ~ ':53') %}
{% endif %}
{% if powerdns_resolver_anycast_v6_ula is defined %}
{% set _ = anycast_addrs.append('[' ~ powerdns_resolver_anycast_v6_ula ~ ']:53') %}
{% endif %}
{% if powerdns_resolver_anycast_v6_gua is defined %}
{% set _ = anycast_addrs.append('[' ~ powerdns_resolver_anycast_v6_gua ~ ']:53') %}
{% endif %}
{% for addr in anycast_addrs %}
{{ 'setLocal' if loop.first else 'addLocal' }}("{{ addr }}", {reusePort=true})
{% endfor %}
{% if site_gua_prefix is defined %}
addACL("{{ site_gua_prefix }}")
{% endif %}
newServer({address="127.0.0.1:53", pool=""})

