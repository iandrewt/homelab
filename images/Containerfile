# What every image is built with, on a laptop and in CI alike
FROM debian:trixie@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1

ARG MKOSI_COMMIT=ecf7f5702bb2052b7a69cab3fe7d37bc3b9ad77b

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      apt ca-certificates cpio cryptsetup-bin dosfstools e2fsprogs efitools erofs-utils fdisk git gpg gpg-agent \
      libcryptsetup12 libtss2-esys-3.0.2-0t64 libtss2-mu-4.0.1-0t64 libtss2-rc0t64 mtools openssl ovmf python3 python3-pefile qemu-system-arm qemu-system-x86 qemu-utils \
      rsync sbsigntool swtpm swtpm-tools systemd systemd-boot systemd-boot-efi systemd-repart systemd-ukify \
      uuid-runtime xorriso zstd \
 && rm -rf /var/lib/apt/lists/*

# v27.1: trixie's mkosi has no Snapshot=
RUN git clone --quiet --branch v27.1 https://github.com/systemd/mkosi /opt/mkosi \
 && test "$(git -C /opt/mkosi rev-parse HEAD)" = "${MKOSI_COMMIT}" \
 && printf '#!/bin/sh\nPYTHONPATH=/opt/mkosi exec python3 -m mkosi "$@"\n' > /usr/local/bin/mkosi \
 && chmod +x /usr/local/bin/mkosi
