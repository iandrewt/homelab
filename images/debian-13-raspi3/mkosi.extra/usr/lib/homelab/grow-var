#!/bin/sh
# While mounted: grown before, an MBR partition drops out mid-boot and takes what waits on it.
# growpart exits 1, NOCHANGE, once it fills the disk.
set -eu
part=$(findmnt --noheadings --output SOURCE /var)
disk=/dev/$(lsblk --noheadings --output PKNAME "$part")
growpart "$disk" "$(cat "/sys/class/block/${part#/dev/}/partition")" || [ $? -eq 1 ]
resize2fs "$part"
