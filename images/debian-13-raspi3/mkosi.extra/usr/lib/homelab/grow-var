#!/bin/sh
# Grows the partition labelled var to the end of its disk, before /var mounts and grows its
# filesystem to match (x-systemd.growfs). growpart exits 1, NOCHANGE, once it fills the disk.
set -eu
part=$(readlink -f /dev/disk/by-label/var)
disk=/dev/$(lsblk --noheadings --output PKNAME "$part")
growpart "$disk" "$(cat "/sys/class/block/${part#/dev/}/partition")" || [ $? -eq 1 ]
