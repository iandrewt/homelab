#!/bin/sh
# Stage 2, over the baked tree: an empty machine's /etc and /var are made from /usr
set -eu

# What it doesn't take of the bake, gone before /etc becomes the confext: AIDE, since verity checks
# /usr and the confext on every read; the upgraders, since nothing upgrades in place; and CIS's
# block on overlayfs, which sysext and confext merge with
dpkg --purge aide aide-common unattended-upgrades
rm -f /etc/systemd/system/dailyaidecheck.* /etc/systemd/system/*.wants/dailyaidecheck.* \
  /etc/apt/apt.conf.d/22auto-upgrades-local /etc/apt/apt.conf.d/52unattended-upgrades-local
sed -i '/^install overlay /d' /etc/modprobe.d/CIS.conf
sed -i '/^blacklist overlay$/d' /etc/modprobe.d/blacklist.conf

# Where mkosi takes the kernel it builds the UKI from
for k in /boot/vmlinuz-*; do cp "$k" "/usr/lib/modules/${k#/boot/vmlinuz-}/vmlinuz"; done

# Nobody reads these on an appliance; each package's licence stays, since the image is distributed
find /usr/share/doc -mindepth 1 ! -name copyright ! -type d -delete
find /usr/share/doc -mindepth 1 -type d -empty -delete
rm -rf /usr/share/man /usr/share/info /usr/share/locale /usr/share/i18n

# What's read before /etc is restored on first boot moves to /usr, where an update carries it too
for pair in sysctl.d:/usr/lib/sysctl.d modprobe.d:/usr/lib/modprobe.d udev/rules.d:/usr/lib/udev/rules.d \
            tmpfiles.d:/usr/lib/tmpfiles.d \
            $(cd /etc/systemd && for d in *.conf.d; do [ -d "$d" ] && echo "systemd/$d:/usr/lib/systemd/$d"; done); do
  from=/etc/${pair%%:*} to=${pair#*:}
  for f in "$from"/*.conf; do
    if [ -f "$f" ] && [ ! -L "$f" ]; then mkdir -p "$to" && mv "$f" "$to/"; fi
  done
done
if [ -f /etc/systemd/coredump.conf ]; then
  mkdir -p /usr/lib/systemd/coredump.conf.d && mv /etc/systemd/coredump.conf /usr/lib/systemd/coredump.conf.d/60-etc.conf
fi
cd /etc/systemd/system
for entry in *; do
  if [ -L "$entry" ] && [ "$(readlink "$entry")" = /dev/null ]; then
    ln -sfn /dev/null "/usr/lib/systemd/system/$entry" && rm "$entry"
  elif [ -d "$entry" ] && case $entry in *.wants|*.requires) true;; *) false;; esac; then
    mkdir -p "/usr/lib/systemd/system/$entry"
    # mkosi's presets enabled pcrlock's, a policy nothing here has chosen
    for link in "$entry"/*; do
      case $link in */systemd-pcrlock*) ;; *) ln -sfn "../$(basename "$link")" "/usr/lib/systemd/system/$link";; esac
    done
    rm -r "$entry"
  elif [ -d "$entry" ]; then
    mkdir -p "/usr/lib/systemd/system/$entry" && mv "$entry"/* "/usr/lib/systemd/system/$entry/" && rm -r "$entry"
  elif [ -f "$entry" ] && [ ! -L "$entry" ]; then
    mv "$entry" /usr/lib/systemd/system/
  fi
done
cd /
# Its one line is CIS's /dev/shm, which the generators would read before /etc is restored: dev-shm-options' now
rm -f /etc/fstab
# With no package database there's nothing for apt's timers to do
for timer in apt-daily.timer apt-daily-upgrade.timer; do ln -sfn /dev/null "/usr/lib/systemd/system/$timer"; done

# Users and groups, as sysusers makes them at boot
mkdir -p /usr/lib/sysusers.d
{
  awk -F: '{ print "g", $1, $3 }' /etc/group
  awk -F: '{ printf "u %s %s:%s \"%s\" %s %s\n", $1, $3, $4, $5, $6, $7 }' /etc/passwd
  awk -F: '$4 != "" { n = split($4, members, ","); for (i = 1; i <= n; i++) print "m", members[i], $1 }' /etc/group
} > /usr/lib/sysusers.d/00-image.conf

# /etc as a configuration extension in /usr, merged under the machine's own before tmpfiles
rm -rf /usr/lib/confexts/base
mkdir -p /usr/lib/confexts/base
cp -a /etc /usr/lib/confexts/base/etc
cd /usr/lib/confexts/base/etc
# Every package here has a native unit, and a removed one's init script would become a failing one
rm -rf passwd* group* shadow* gshadow* subuid* subgid* machine-id hostname .pwd.lock .updated adjtime \
  ssh/ssh_host_* systemd/system/* init.d rc?.d
. /usr/lib/os-release
mkdir -p extension-release.d
printf 'ID=%s\nVERSION_ID=%s\n' "$ID" "$VERSION_ID" > extension-release.d/extension-release.base

# /var, copied in once by tmpfiles, where the machine's own state then lives
rm -rf /usr/share/factory/var
mkdir -p /usr/share/factory
cp -a /var /usr/share/factory/var
cd /usr/share/factory/var
rm -rf lib/dpkg lib/apt cache
# A package makes its own log directory, at install
find log ! -type d -delete
cd /usr/share/factory
for p in var/*/*; do
  if [ -L "$p" ]; then echo "L /$p - - - - $(readlink "$p")"
  elif [ -e "$p" ]; then echo "C /$p - - - - /usr/share/factory/$p"
  fi
done > /usr/lib/tmpfiles.d/00-image.conf
