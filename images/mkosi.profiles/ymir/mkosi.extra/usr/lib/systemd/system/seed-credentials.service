[Unit]
Description=Credentials from the seed drive
DefaultDependencies=no
Requires=dev-disk-seed.device
After=dev-disk-seed.device
# Not sysusers: udev, which finds the drive, starts after it
Before=sysinit.target systemd-tmpfiles-setup.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/homelab/seed-credentials
