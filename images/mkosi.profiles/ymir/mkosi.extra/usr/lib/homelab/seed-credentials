#!/bin/sh
# What Proxmox's cloud-init drive says of the machine, its name and keys, as the credentials ImportCredential=
# reads. Its network is the image's own, DHCP and SLAAC, and its resolvers the lease's
set -eu
umask 077
mkdir -p /run/seed /run/credstore
mount -o ro,nodev,nosuid,noexec /dev/disk/seed /run/seed
trap 'umount /run/seed' EXIT

section='' user=debian keys=''
while IFS= read -r line || [ -n "$line" ]; do
  case $line in ' '*) ;; *) section=${line%%:*} ;; esac
  case $section:$line in
    hostname:hostname:*) printf %s "${line#hostname: }" > /run/credstore/system.hostname ;;
    user:user:*) user=${line#user: } ;;
    'ssh_authorized_keys:  - '*) keys="$keys${line#  - }
" ;;
  esac
done < /run/seed/user-data
if [ "$user" != debian ]; then
  echo "the seed's user is $user, and debian is the only one" >&2
  exit 1
fi
[ -z "$keys" ] || printf %s "$keys" > /run/credstore/ssh.authorized_keys.debian

# PID 1 took its hostname before this ran, from /etc/hostname if the machine has set one
if [ -s /run/credstore/system.hostname ] && [ ! -s /etc/hostname ]; then
  hostname "$(cat /run/credstore/system.hostname)"
fi
