#!/bin/sh
# What Proxmox's cloud-init drive says of the machine, its name, keys and network, as the credentials
# ImportCredential= reads and networkd's own units. Its nameservers are the VM's, or its node's, which
# are the recursor's; the search list is always the lease's.
set -eu
umask 077
mkdir -p /run/seed /run/credstore
mount -o ro,nodev,nosuid,noexec /dev/disk/seed /run/seed
trap 'umount /run/seed' EXIT

unquote() { value=${1#\'}; printf %s "${value%\'}"; }

section= user=debian keys=
while IFS= read -r line || [ -n "$line" ]; do
  case $line in ' '*) ;; *) section=${line%%:*} ;; esac
  case $section:$line in
    hostname:hostname:*) printf %s "${line#hostname: }" > /run/credstore/system.hostname ;;
    user:user:*) user=${line#user: } ;;
    'ssh_authorized_keys:  - '*) keys="$keys${line#  - }
" ;;
  esac
done < /run/seed/user-data
if [ "$user" != debian ]; then
  echo "the seed's user is $user, and debian is the only one" >&2
  exit 1
fi
[ -z "$keys" ] || printf %s "$keys" > /run/credstore/ssh.authorized_keys.debian

prefix() { # a dotted netmask's length
  bits=0
  for octet in $(echo "$1" | tr . ' '); do
    case $octet in
      255) bits=$((bits + 8)) ;; 254) bits=$((bits + 7)) ;; 252) bits=$((bits + 6)) ;;
      248) bits=$((bits + 5)) ;; 240) bits=$((bits + 4)) ;; 224) bits=$((bits + 3)) ;;
      192) bits=$((bits + 2)) ;; 128) bits=$((bits + 1)) ;;
    esac
  done
  echo "$bits"
}

units=/run/systemd/network
mkdir -p "$units"
written= dns= entry= name= mac= dhcp4= dhcp6= ra= addresses= subnet= address= list=
flush() {
  [ "$entry" = physical ] && [ -n "$mac" ] || return 0
  if [ -n "$dhcp4" ] && [ -n "$dhcp6" ]; then dhcp=yes
  elif [ -n "$dhcp4" ]; then dhcp=ipv4
  elif [ -n "$dhcp6" ]; then dhcp=ipv6
  else dhcp=no; fi
  unit=$units/50-seed-$name.network
  printf '[Match]\nMACAddress=%s\n\n[Network]\nDHCP=%s\nIPv6AcceptRA=%s\nEmitLLDP=yes\nLinkLocalAddressing=ipv6\nUseDomains=yes\n%s' \
    "$mac" "$dhcp" "${ra:-no}" "$addresses" > "$unit"
  written="$written $unit"
}
if [ -f /run/seed/network-config ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    item=${line#"${line%%[! ]*}"}
    case $entry:$item in
      *:'- type: physical'|*:'- type: nameserver')
        flush
        entry=${item#- type: } name= mac= dhcp4= dhcp6= ra= addresses= subnet= list= ;;
      physical:'name: '*) name=${item#name: } ;;
      physical:'mac_address: '*) mac=$(unquote "${item#mac_address: }") ;;
      physical:'- type: '*)
        subnet=${item#- type: }
        case $subnet in
          dhcp4) dhcp4=1 ;;
          dhcp6) dhcp6=1 ra=yes ;;
          ipv6_slaac|static6) ra=yes ;;
        esac ;;
      physical:'address: '*)
        address=$(unquote "${item#address: }")
        [ "$subnet" != static6 ] || addresses="${addresses}Address=$address
" ;;
      physical:'netmask: '*) addresses="${addresses}Address=$address/$(prefix "$(unquote "${item#netmask: }")")
" ;;
      physical:'gateway: '*) addresses="${addresses}Gateway=$(unquote "${item#gateway: }")
" ;;
      nameserver:address:|nameserver:search:) list=${item%:} ;;
      nameserver:"- '"*) [ "$list" != address ] || dns="$dns $(unquote "${item#- }")" ;;
    esac
  done < /run/seed/network-config
  flush
fi
for unit in $written; do
  for server in $dns; do echo "DNS=$server"; done >> "$unit"
  [ -z "$dns" ] || printf '\n[DHCPv4]\nUseDNS=no\n\n[DHCPv6]\nUseDNS=no\n\n[IPv6AcceptRA]\nUseDNS=no\n' >> "$unit"
  chmod 644 "$unit"
done

# PID 1 took its hostname before this ran, from /etc/hostname if the machine has set one
if [ -s /run/credstore/system.hostname ] && [ ! -s /etc/hostname ]; then
  hostname "$(cat /run/credstore/system.hostname)"
fi
