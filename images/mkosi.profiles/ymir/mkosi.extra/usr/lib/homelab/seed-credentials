#!/bin/sh
# The seed's user-data, one credential a line as SMBIOS type 11 carries them, into the credstore
# ImportCredential= reads
set -eu
umask 077
mkdir -p /run/seed /run/credstore
mount -o ro,nodev,nosuid,noexec /dev/disk/by-label/cidata /run/seed
trap 'umount /run/seed' EXIT
while IFS= read -r line || [ -n "$line" ]; do
  case $line in
    io.systemd.credential:*=*) credential=${line#*:} decode=cat ;;
    io.systemd.credential.binary:*=*) credential=${line#*:} decode="base64 -d" ;;
    *) continue ;;
  esac
  name=${credential%%=*}
  case $name in */*|.*) echo "skipping a credential named $name" >&2; continue ;; esac
  printf %s "${credential#*=}" | $decode > "/run/credstore/$name"
done < /run/seed/user-data
# PID 1 took its hostname before this ran, from /etc/hostname if the machine has set one
if [ -s /run/credstore/system.hostname ] && [ ! -s /etc/hostname ]; then
  hostname "$(cat /run/credstore/system.hostname)"
fi
