locals {
  token_id = "${var.user_id}!${var.token_name}"

  # ACLs are keyed by path+role so adding one doesn't re-index the others.
  acls = { for a in var.acls : "${a.path}|${a.role_id}" => a }
}

resource "proxmox_user_token" "this" {
  user_id    = var.user_id
  token_name = var.token_name
  comment    = var.comment

  privileges_separation = true
}

resource "proxmox_acl" "this" {
  for_each = local.acls

  token_id  = proxmox_user_token.this.id
  path      = each.value.path
  role_id   = each.value.role_id
  propagate = each.value.propagate
}

resource "onepassword_item" "token" {
  vault    = var.onepassword_vault
  title    = var.item_title
  category = "password"
  username = local.token_id

  password = "${local.token_id}=${proxmox_user_token.this.value}"

  note_value = "Generated by OpenTofu (tofu/modules/proxmox-identity)."
}
