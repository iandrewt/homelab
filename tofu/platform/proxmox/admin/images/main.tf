locals {
  fetch_node = sort(keys(local.cluster.nodes))[0]
}

resource "proxmox_download_file" "this" {
  for_each = local.library.images

  node_name    = local.fetch_node
  datastore_id = local.cluster.image_storage
  content_type = each.value.content_type
  url          = each.value.url
  file_name    = each.value.file_name

  checksum           = each.value.checksum
  checksum_algorithm = each.value.checksum_algorithm
}

# What a tenant may boot, by volume, from where every cell at the site mounts it
data "onepassword_vault" "tenant" {
  for_each = local.tenants

  name = module.tenancy.teams[each.key].title
}

resource "onepassword_item" "library" {
  for_each = local.tenants

  vault    = data.onepassword_vault.tenant[each.key].uuid
  title    = "Proxmox Image Library - ${terraform.workspace}"
  category = "secure_note"
  tags     = ["homelab/managed-by-tofu"]

  section {
    label = "images"

    dynamic "field" {
      for_each = proxmox_download_file.this
      content {
        label = field.key
        type  = "STRING"
        value = field.value.id
      }
    }
  }

  note_value = "Generated by OpenTofu (tofu/platform/proxmox/admin/images)."
}

output "volume_ids" {
  description = "Volume id of each downloaded image."
  value       = { for k, v in proxmox_download_file.this : k => v.id }
}
