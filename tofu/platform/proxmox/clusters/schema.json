{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iandrewt/homelab/tofu/clusters/schema.json",
  "title": "Proxmox cluster facts",
  "description": "Cluster configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "endpoint",
    "onepassword_vault",
    "onepassword_break_glass_vault",
    "ssh_username",
    "timezone",
    "mailto",
    "firewall",
    "sdn",
    "storages",
    "guest_defaults",
    "backup",
    "nodes",
    "image_storage",
    "images",
    "tenants",
    "mac_prefix"
  ],
  "properties": {
    "site": {
      "description": "NetBox site slug.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,6}[a-z0-9]$"
    },
    "onepassword_vault": {
      "description": "The team that runs the cluster: its tokens are written here, and `SSH Key - <vault>` is read from here. A tenant's go in the vault named for it.",
      "type": "string"
    },
    "onepassword_break_glass_vault": {
      "description": "Where each node's root login lives: read by hand, at install, and never by automation.",
      "type": "string"
    },
    "ssh_username": {
      "description": "Linux account the OpenTofu provider connects as.",
      "type": "string"
    },
    "timezone": {
      "description": "tzdata name.",
      "type": "string"
    },
    "mailto": {
      "description": "root's email address, set by the installer.",
      "type": "string"
    },
    "firewall": {
      "description": "Datacenter firewall policy. INPUT and FORWARD default to DROP, so management_vlans is the only way in to 8006 and 22.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_vlans"
      ],
      "properties": {
        "management_vlans": {
          "description": "VLANs allowed to reach the GUI and SSH.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sdn": {
      "description": "The SDN VLAN zone every VNet is in.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge",
        "mtu"
      ],
      "properties": {
        "bridge": {
          "description": "The trunk bridge it runs on, on every node. proxmox_node builds it from NetBox.",
          "type": "string"
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280
        }
      }
    },
    "oidc": {
      "description": "OIDC realm, such as Entra.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm",
        "issuer_url",
        "client_id"
      ],
      "properties": {
        "realm": {
          "type": "string"
        },
        "issuer_url": {
          "type": "string",
          "format": "uri"
        },
        "client_id": {
          "type": "string"
        },
        "username_claim": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pools"
        ],
        "properties": {
          "pools": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raidlevel",
                "devices"
              ],
              "properties": {
                "raidlevel": {
                  "enum": [
                    "single",
                    "mirror",
                    "raid10",
                    "raidz",
                    "raidz2",
                    "raidz3"
                  ]
                },
                "devices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^/dev/disk/by-id/"
                  }
                },
                "ashift": {
                  "type": "integer"
                },
                "compression": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "file_name"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "file_name": {
            "type": "string"
          },
          "content_type": {
            "enum": [
              "import",
              "iso",
              "vztmpl"
            ]
          },
          "checksum": {
            "type": "string"
          },
          "checksum_algorithm": {
            "type": "string"
          }
        },
        "dependentRequired": {
          "checksum": [
            "checksum_algorithm"
          ],
          "checksum_algorithm": [
            "checksum"
          ]
        }
      }
    },
    "tenants": {
      "description": "A team Platform grants a share of the cluster: a pool, a privsep token that makes its own workloads as pools under it, and the VNets it may join. Anything running inside a workload that needs the Proxmox API itself is an integration, and gets its own identity.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comment"
        ],
        "properties": {
          "comment": {
            "type": "string"
          },
          "vnets": {
            "description": "SDN VNets its VMs may join, by each VLAN's `vnet` in NetBox.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "integrations": {
            "description": "In-workload components needing their own Proxmox credentials, keyed by a short name. Each gets a user, a privsep token, and one role per ACL entry.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "comment",
                "acls"
              ],
              "properties": {
                "comment": {
                  "type": "string"
                },
                "acls": {
                  "description": "Privileges granted, keyed by ACL path. Nothing is granted implicitly, so the workload's own pool is listed like anything else. A /storage/<id> path must name a key of `storages`, a /pool/<id> a tenant or one of its workloads.",
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^/$|^/(access|nodes|pool|sdn|storage|vms)(/[^/]+)*$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "storages": {
      "description": "Storages this cluster defines, keyed by Proxmox storage ID.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "directory",
              "nfs",
              "zfspool"
            ]
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "images",
                "rootdir",
                "iso",
                "vztmpl",
                "backup",
                "snippets",
                "import"
              ]
            }
          },
          "path": {
            "description": "directory only.",
            "type": "string"
          },
          "server": {
            "description": "nfs only.",
            "type": "string"
          },
          "export": {
            "description": "nfs only.",
            "type": "string"
          },
          "options": {
            "description": "nfs only.",
            "type": "string"
          },
          "pool": {
            "description": "zfspool only.",
            "type": "string"
          },
          "thin_provision": {
            "description": "zfspool only.",
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "directory"
                }
              }
            },
            "then": {
              "required": [
                "path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "nfs"
                }
              }
            },
            "then": {
              "required": [
                "server",
                "export"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "zfspool"
                }
              }
            },
            "then": {
              "required": [
                "pool"
              ]
            }
          }
        ]
      }
    },
    "guest_defaults": {
      "description": "Defaults for guests built on this cluster.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disk_storage",
        "snippet_storage"
      ],
      "properties": {
        "disk_storage": {
          "description": "Must be a key of `storages`.",
          "type": "string"
        },
        "snippet_storage": {
          "description": "Must be a key of `storages`, and must be node-local.",
          "type": "string"
        }
      }
    },
    "backup": {
      "description": "The one vzdump job, covering every guest on every node.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "schedule",
        "retention"
      ],
      "properties": {
        "storage": {
          "description": "An `nfs` key of `storages`, with `backup` in its content.",
          "type": "string"
        },
        "schedule": {
          "description": "systemd calendar event.",
          "type": "string"
        },
        "retention": {
          "description": "Proxmox's prune options, applied after each run.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "keep-last",
              "keep-hourly",
              "keep-daily",
              "keep-weekly",
              "keep-monthly",
              "keep-yearly"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "image_storage": {
      "description": "Storage the image library lives on. Must be a key of `storages`.",
      "type": "string"
    },
    "mac_prefix": {
      "description": "Three-octet OUI for MACs this cluster generates.",
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}:){2}[0-9A-Fa-f]{2}$"
    },
    "endpoint": {
      "description": "Proxmox API URL.",
      "type": "string",
      "format": "uri"
    }
  }
}
