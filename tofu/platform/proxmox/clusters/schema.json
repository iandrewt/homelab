{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iandrewt/homelab/tofu/clusters/schema.json",
  "title": "Proxmox cluster facts",
  "description": "Cluster configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "endpoint",
    "onepassword_vault",
    "onepassword_break_glass_vault",
    "timezone",
    "mailto",
    "release",
    "sdn",
    "storages",
    "guest_defaults",
    "backup",
    "nodes",
    "image_storage",
    "tenants",
    "mac_prefix"
  ],
  "properties": {
    "site": {
      "description": "NetBox site slug.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,6}[a-z0-9]$"
    },
    "onepassword_vault": {
      "description": "The running team's vault: its tokens go here, and `SSH Key - <vault>` comes from here.",
      "type": "string"
    },
    "onepassword_break_glass_vault": {
      "description": "Where each node's root login lives: read by hand, at install, and never by automation.",
      "type": "string"
    },
    "timezone": {
      "description": "tzdata name.",
      "type": "string"
    },
    "mailto": {
      "description": "root's email address, set by the installer.",
      "type": "string"
    },
    "release": {
      "description": "The Proxmox VE major release a new node installs, from its newest ISO.",
      "type": "integer",
      "minimum": 9
    },
    "sdn": {
      "description": "The SDN VLAN zone every VNet is in.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge",
        "mtu"
      ],
      "properties": {
        "bridge": {
          "description": "The trunk bridge it runs on, on every node. proxmox_node builds it from NetBox.",
          "type": "string"
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pools"
        ],
        "properties": {
          "pools": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raidlevel",
                "devices"
              ],
              "properties": {
                "raidlevel": {
                  "enum": [
                    "single",
                    "mirror",
                    "raid10",
                    "raidz",
                    "raidz2",
                    "raidz3"
                  ]
                },
                "devices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^/dev/disk/by-id/"
                  }
                },
                "ashift": {
                  "type": "integer"
                },
                "compression": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "tenants": {
      "description": "Teams, from tofu/identity/tenancy/teams, granted a share: a pool, a token that makes its workloads as pools under it, and the VNets it may join.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vnets": {
            "description": "SDN VNets its VMs may join, by each VLAN's `vnet` in NetBox.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "mappings": {
            "description": "PCI mappings its VMs may pass through, by name in `mappings.pci`.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "integrations": {
            "description": "Something inside a workload that needs Proxmox credentials of its own: a user, a privsep token, and a role per ACL path.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "comment",
                "acls"
              ],
              "properties": {
                "comment": {
                  "type": "string"
                },
                "acls": {
                  "description": "Privileges by ACL path. Nothing is implicit, the workload's own pool included.",
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^/$|^/(access|nodes|pool|sdn|storage|vms)(/[^/]+)*$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "storages": {
      "description": "Storages this cluster defines, keyed by Proxmox storage ID.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "enum": [
              "directory",
              "nfs",
              "zfspool"
            ]
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "images",
                "rootdir",
                "iso",
                "vztmpl",
                "backup",
                "import"
              ]
            }
          },
          "path": {
            "description": "directory only.",
            "type": "string"
          },
          "server": {
            "description": "nfs only.",
            "type": "string"
          },
          "export": {
            "description": "nfs only.",
            "type": "string"
          },
          "options": {
            "description": "nfs only.",
            "type": "string"
          },
          "pool": {
            "description": "zfspool only.",
            "type": "string"
          },
          "thin_provision": {
            "description": "zfspool only.",
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "directory"
                }
              }
            },
            "then": {
              "required": [
                "path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "nfs"
                }
              }
            },
            "then": {
              "required": [
                "server",
                "export"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "zfspool"
                }
              }
            },
            "then": {
              "required": [
                "pool"
              ]
            }
          }
        ]
      }
    },
    "guest_defaults": {
      "description": "Defaults for guests built on this cluster.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disk_storage"
      ],
      "properties": {
        "disk_storage": {
          "description": "Must be a key of `storages`.",
          "type": "string"
        }
      }
    },
    "mappings": {
      "description": "Hardware a guest may be given, by mapping name. A tenant is granted a mapping by name.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pci": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "devices"
            ],
            "properties": {
              "comment": {
                "type": "string"
              },
              "devices": {
                "description": "The device on each node that has one, keyed by node.",
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "id",
                    "subsystem_id",
                    "iommu_group"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
                    },
                    "id": {
                      "description": "vendor:device, from `lspci -nn`.",
                      "type": "string",
                      "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$"
                    },
                    "subsystem_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$"
                    },
                    "iommu_group": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "description": "The one vzdump job, covering every guest on every node.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "schedule",
        "retention"
      ],
      "properties": {
        "storage": {
          "description": "An `nfs` key of `storages`, with `backup` in its content.",
          "type": "string"
        },
        "schedule": {
          "description": "systemd calendar event.",
          "type": "string"
        },
        "retention": {
          "description": "Proxmox's prune options, applied after each run.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "keep-last",
              "keep-hourly",
              "keep-daily",
              "keep-weekly",
              "keep-monthly",
              "keep-yearly"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "image_storage": {
      "description": "The storage holding the site's image library. A key of `storages`.",
      "type": "string"
    },
    "mac_prefix": {
      "description": "Three-octet OUI for MACs this cluster generates.",
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}:){2}[0-9A-Fa-f]{2}$"
    },
    "endpoint": {
      "description": "Proxmox API URL.",
      "type": "string",
      "format": "uri"
    },
    "insecure": {
      "description": "Skip verifying the nodes' certificates: true until the private CA issues them.",
      "type": "boolean"
    }
  }
}
